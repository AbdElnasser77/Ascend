PORT=4000
CORS_ORIGIN=http://localhost:5173
# Postgres connection string (a Neon URL works as-is)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Two long random strings, different from each other:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Where the web app is served (used in password reset emails). Defaults to CORS_ORIGIN.
APP_URL=http://localhost:5173
# Optional: send real emails through Resend (https://resend.com). Without it, emails print to the API console.
RESEND_API_KEY=
MAIL_FROM=Ascend <onboarding@resend.dev>
