{
  "name": "ascend",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @ascend/api\" \"npm run dev -w @ascend/web\"",
    "dev:api": "npm run dev -w @ascend/api",
    "dev:web": "npm run dev -w @ascend/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "typescript": "^5.9.2"
  }
}
